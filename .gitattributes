# Stable UTF-8 text line endings across Windows and Unix checkouts.
* text=auto
*.dart text eol=lf
*.kt text eol=lf
*.java text eol=lf
*.md text eol=lf
*.json text eol=lf
pubspec.lock text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.ps1 text eol=lf
*.svg text eol=lf
.gitignore text eol=lf
LICENSE text eol=lf
android/gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
